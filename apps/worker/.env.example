# =========================================================
# Noor Worker — Python / FastAPI
# Validated at startup by app/settings.py (pydantic-settings). A missing or
# malformed WORKER_INTERNAL_TOKEN crashes the process at import time — see
# docs/operations/environment-variables.md.
# =========================================================

WORKER_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080

# Required only when WORKER_PROCESSING_MODE=noop (see below) — the
# orchestration polling loop calls Supabase PostgREST RPC endpoints with
# these. Left empty, the loop simply does not start (logged as a warning,
# never a crash) — see docs/operations/worker-processing-runbook.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required. Protects POST /jobs. Generate with: openssl rand -hex 32
# Never commit a real value here.
WORKER_INTERNAL_TOKEN=

WEB_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Not required until AI Gateway implementation exists — optional.
AI_GATEWAY_PROVIDER=
AI_GATEWAY_API_KEY=

# =========================================================
# Durable processing orchestration (Sprint 1.2A)
# See docs/domain/document-processing-orchestration.md and ADR 0009.
# =========================================================

# Stable per-process worker identity, used as the lease owner name. If
# left empty, one is generated at startup (noor-worker-<env>-<6 hex chars>)
# and stays fixed for the process's lifetime. Set explicitly in production
# if you want a predictable, greppable name across restarts of the same
# deployment slot.
WORKER_INSTANCE_ID=

# How often (seconds) the idle loop polls for a claimable job.
WORKER_POLL_INTERVAL_SECONDS=5

# How long (seconds) a claimed lease is valid before it is eligible for
# crash recovery. Must be greater than WORKER_HEARTBEAT_INTERVAL_SECONDS.
WORKER_LEASE_DURATION_SECONDS=90

# How often (seconds) an in-progress job's lease is renewed. Should be
# roughly 1/3 of WORKER_LEASE_DURATION_SECONDS so a single missed
# heartbeat never expires the lease.
WORKER_HEARTBEAT_INTERVAL_SECONDS=30

# Reserved for future parallelism; the current loop only ever processes
# one job at a time regardless of this value.
WORKER_MAX_CONCURRENT_JOBS=1

# "disabled" (default — the orchestration loop does not start; safe for
# every existing deployment and test run), "noop" (runs the real
# claim/heartbeat/complete lifecycle against a controlled no-op processor
# that never parses real document content — see ADR 0009), "extraction"
# (Sprint 1.2B — runs the real, deterministic PDF text-extraction
# processor; see ADR 0010), or "ocr" (Sprint 1-D2 — runs the controlled
# page-scoped OCR processor against pages an extraction review explicitly
# flagged; see ADR 0012). Set WORKER_ENABLED_JOB_TYPES=document_ocr
# alongside this to actually claim OCR page jobs.
WORKER_PROCESSING_MODE=disabled

# =========================================================
# Deterministic PDF extraction (Sprint 1.2B)
# See docs/domain/document-extraction-lifecycle.md and ADR 0010.
# =========================================================

# Comma-separated document_processing_jobs.job_type values this Worker
# will claim. Reuses the existing `document_parsing` value from migration
# 0006 — that job_type has always meant "this job's payload is a PDF that
# needs its text extracted"; Sprint 1.2B is what implements it for real.
WORKER_ENABLED_JOB_TYPES=document_parsing

# Leave both empty to use the pinned defaults in
# app/pdf_extraction/config.py (recommended — only override for a
# deliberate, reviewed version bump; see ADR 0010's upgrade policy).
EXTRACTION_PIPELINE_VERSION=
EXTRACTION_CONFIGURATION_VERSION=

# Bounded wall-clock timeout (seconds) for one extraction attempt. On
# timeout, the attempt is reported as `extraction_timeout` (retryable) —
# the extraction thread itself keeps running to completion in the
# background rather than being unsafely killed (mission §26); its result
# is simply discarded.
EXTRACTION_MAX_SECONDS=300

# Leave empty to use the OS default temporary directory
# (tempfile.mkdtemp()). Only set this if your deployment platform requires
# temp files to live on a specific volume.
EXTRACTION_TEMP_DIRECTORY=

# =========================================================
# Controlled page-scoped OCR (Sprint 1-D2)
# See docs/domain/ocr-eligibility-and-lifecycle.md and ADR 0012.
# OCR processing is disabled by default (mission §28) — WORKER_PROCESSING_MODE
# must be explicitly set to "ocr" (and WORKER_ENABLED_JOB_TYPES to
# document_ocr) before any page is ever rendered or sent to the OCR engine.
# =========================================================

# Leave all four empty to use the pinned defaults in app/ocr/config.py
# (recommended — only override for a deliberate, reviewed version bump;
# see ADR 0012's upgrade policy). Any change here must be paired with a
# reviewed change to the matching constant in app/ocr/config.py, since the
# constant — not this env var — is what the startup pin-assertions and the
# OCR identity actually check against.
OCR_PIPELINE_VERSION=
OCR_CONFIGURATION_VERSION=
OCR_RENDER_CONFIGURATION_VERSION=
OCR_RENDER_DPI=

# Leave empty to use the pinned defaults (rgb / png). Changing either is a
# render-configuration-version-bumping change (mission §16) — a different
# pixel input is, by definition, a different OCR run identity.
OCR_RENDER_COLOR_MODE=
OCR_RENDER_IMAGE_FORMAT=

# Bounded wall-clock timeout (seconds), applied independently to the render
# phase and the OCR-recognition phase. On timeout, the attempt is reported
# as `ocr_timeout` (retryable) — the underlying thread keeps running to
# completion in the background rather than being unsafely killed (mission
# §26); its result is simply discarded.
OCR_MAX_SECONDS=300

# Leave empty to use the OS default temporary directory
# (tempfile.mkdtemp()). Only set this if your deployment platform requires
# temp files to live on a specific volume.
OCR_TEMP_DIRECTORY=

# Leave empty to use app/ocr/config.py's DEFAULT_TESSDATA_DIR
# (apps/worker/tessdata/, populated by scripts/fetch_tessdata_models.py and
# baked into the Docker image at build time). Startup fails closed
# (assert_pinned_tessdata_models) if the pinned, checksum-verified models
# are not present at this path.
OCR_TESSDATA_DIR=
